@startuml ClassDiagram
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classFontName Arial
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam padding 3
skinparam shadowing false

class Customer {
  - customerID : int
  - name : String
  - email : String
  - phoneNumber : String
  - address : String
  - registrationDate : LocalDate
  --
  + Customer(id, name, email, phone, address, date)
  + getCustomerID() : int
  + setCustomerID(int) : void
  + getName() : String
  + setName(String) : void
  + getEmail() : String
  + setEmail(String) : void
  + getPhoneNumber() : String
  + setPhoneNumber(String) : void
  + getAddress() : String
  + setAddress(String) : void
  + getRegistrationDate() : LocalDate
  + setRegistrationDate(LocalDate) : void
}

class Developer {
  - developerID : int
  - name : String
  - contactName : String
  - phoneNumber : String
  - email : String
  - address : String
  --
  + Developer(id, name, contact, phone, email, addr)
  + getDeveloperID() : int
  + setDeveloperID(int) : void
  + getName() : String
  + setName(String) : void
  + getContactName() : String
  + setContactName(String) : void
  + getPhoneNumber() : String
  + setPhoneNumber(String) : void
  + getEmail() : String
  + setEmail(String) : void
  + getAddress() : String
  + setAddress(String) : void
}

class Game {
  - gameID : int
  - title : String
  - description : String
  - price : double
  - stockQuantity : int
  - genreID : int
  - developerID : int
  --
  + Game(id, title, desc, price, qty, genreID, devID)
  + getGameID() : int
  + setGameID(int) : void
  + getTitle() : String
  + setTitle(String) : void
  + getDescription() : String
  + setDescription(String) : void
  + getPrice() : double
  + setPrice(double) : void
  + getStockQuantity() : int
  + setStockQuantity(int) : void
  + getGenreID() : int
  + setGenreID(int) : void
  + getDeveloperID() : int
  + setDeveloperID(int) : void
}

class Genre {
  - genreID : int
  - name : String
  - description : String
  --
  + Genre(id, name, description)
  + getGenreID() : int
  + setGenreID(int) : void
  + getName() : String
  + setName(String) : void
  + getDescription() : String
  + setDescription(String) : void
}

class Purchase {
  - purchaseID : int
  - customerID : int
  - purchaseDate : LocalDate
  - totalAmount : double
  - status : String
  - gameID : int
  - count : int
  --
  + Purchase(id, custID, date, total, status, gameID, count)
  + getPurchaseID() : int
  + setPurchaseID(int) : void
  + getCustomerID() : int
  + setCustomerID(int) : void
  + getPurchaseDate() : LocalDate
  + setPurchaseDate(LocalDate) : void
  + getTotalAmount() : double
  + setTotalAmount(double) : void
  + getStatus() : String
  + setStatus(String) : void
  + getGameID() : int
  + setGameID(int) : void
  + getCount() : int
  + setCount(int) : void
}

class CustomerService {
  - {static} URL : String
  - {static} USER : String
  - {static} PASSWORD : String
  --
  + getCustomers() : List<Customer>
  + createCustomer(Customer) : void
  + updateCustomer(Customer) : void
  + deleteCustomer(int) : void
}

class DeveloperService {
  - {static} URL : String
  - {static} USER : String
  - {static} PASSWORD : String
  --
  + getDevelopers() : List<Developer>
  + createDeveloper(Developer) : void
  + updateDeveloper(Developer) : void
  + deleteDeveloper(int) : void
}

class GameService {
  - {static} URL : String
  - {static} USER : String
  - {static} PASSWORD : String
  --
  + getGames() : List<Game>
  + createGame(Game) : void
  + updateGame(Game) : void
  + deleteGame(int) : void
}

class GenreService {
  - {static} URL : String
  - {static} USER : String
  - {static} PASSWORD : String
  --
  + getGenres() : List<Genre>
  + createGenre(Genre) : void
  + updateGenre(Genre) : void
  + deleteGenre(int) : void
}

class PurchaseService {
  - {static} URL : String
  - {static} USER : String
  - {static} PASSWORD : String
  --
  + getPurchases() : List<Purchase>
  + createPurchase(Purchase) : void
  + updatePurchase(Purchase) : void
  + deletePurchase(int) : void
}

class MainView {
  - tabs : Tabs
  - tabContents : Map<Tab, VerticalLayout>
  - gameService : GameService
  - purchaseService : PurchaseService
  - customerService : CustomerService
  - developerService : DeveloperService
  - genreService : GenreService
  - dashboard : DashboardView
  --
  + MainView(gameService, purchaseService, customerService, developerService, genreService)
}

class DashboardView {
  - games : List<Game>
  - purchases : List<Purchase>
  - customers : List<Customer>
  - developers : List<Developer>
  - genres : List<Genre>
  --
  + DashboardView(purchases, genres, games, customers, developers)
  - createDashboard() : Component
  - createHighlightCard(title, value) : Component
  - getColor(int) : String
  + redraw() : void
}

class CustomerDialogManager {
  - customerService : CustomerService
  - grid : Grid<Customer>
  --
  + CustomerDialogManager(CustomerService, Grid<Customer>)
  + openAddCustomerDialog(List<Customer>) : void
  + openEditCustomerDialog() : void
  + openDelCustomerDialog() : void
}

class DeveloperDialogManager {
  - developerService : DeveloperService
  - grid : Grid<Developer>
  --
  + DeveloperDialogManager(DeveloperService, Grid<Developer>)
  + openAddDeveloperDialog(List<Developer>) : void
  + openEditDeveloperDialog() : void
  + openDelDeveloperDialog(List<Developer>) : void
}

class GameDialogManager {
  - gameService : GameService
  - grid : Grid<Game>
  --
  + GameDialogManager(GameService, Grid<Game>)
  + openAddGameDialog(List<Game>) : void
  + openEditGameDialog() : void
  + openDelGameDialog(List<Game>) : void
}

class GenreDialogManager {
  - genreService : GenreService
  - grid : Grid<Genre>
  --
  + GenreDialogManager(GenreService, Grid<Genre>)
  + openAddGenreDialog(List<Genre>) : void
  + openEditGenreDialog() : void
  + openDelGenreDialog() : void
}

class PurchaseDialogManager {
  - purchaseService : PurchaseService
  - grid : Grid<Purchase>
  --
  + PurchaseDialogManager(PurchaseService, Grid<Purchase>)
  + openAddPurchaseDialog(List<Purchase>) : void
  + openEditPurchaseDialog() : void
  + openDelPurchaseDialog(List<Purchase>) : void
}

class "FieldFilter<T, V>" as FieldFilter {
  - items : List<T>
  - availableValues : Set<V>
  - fieldExtractor : Function<T, V>
  --
  + FieldFilter(List<T>, Function<T, V>)
  + getAvailableValues() : List<V>
  + filterByValue(V) : List<T>
}

class Application {
  + {static} main(String[]) : void
}

' Модели
Game --> Genre
Game --> Developer
Purchase --> Customer
Purchase --> Game

' Сервисы → модели
CustomerService --> Customer
DeveloperService --> Developer
GameService --> Game
GenreService --> Genre
PurchaseService --> Purchase

' MainView → сервисы
MainView --> CustomerService
MainView --> DeveloperService
MainView --> GameService
MainView --> GenreService
MainView --> PurchaseService
MainView --> DashboardView

' Диалоги → сервисы
CustomerDialogManager --> CustomerService
DeveloperDialogManager --> DeveloperService
GameDialogManager --> GameService
GenreDialogManager --> GenreService
PurchaseDialogManager --> PurchaseService

' MainView → диалоги и фильтр
MainView --> CustomerDialogManager
MainView --> DeveloperDialogManager
MainView --> GameDialogManager
MainView --> GenreDialogManager
MainView --> PurchaseDialogManager
MainView --> FieldFilter

' Точка входа
Application --> MainView

@enduml
