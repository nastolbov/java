@startuml ModuleStructure
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageFontSize 14
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam packageBackgroundColor #FFFFFF
skinparam ArrowColor #000000

package "Services" {
  class CustomerService
  class PurchaseService
  class GameService
  class DeveloperService
  class GenreService
}

package "Models" {
  class Game
  class Customer
  class Purchase
  class Developer
  class Genre
}

package "Dialogs" {
  class CustomerDialogManager
  class PurchaseDialogManager
  class GameDialogManager
  class DeveloperDialogManager
  class GenreDialogManager
}

package "Component" {
  class Application
  class FieldFilter
}

package "Views" {
  class MainView
  class DashboardView
}

Services -down-> Models
Models -down-> Dialogs
Dialogs -right-> Views
Component -down-> Views

@enduml
